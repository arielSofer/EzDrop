// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`BackendBlueprint > generates owner-scoped rules with public reads for the shared collections 1`] = `
"rules_version = '2';

// Generated by AgenticDesigner.
//
// Deny by default. A collection is reachable only by the user who owns
// it. \`isVerified()\` is provided so you can additionally gate sensitive
// writes on a confirmed email — e.g. change \`allow create\` to
// \`if isOwner(...) && isVerified()\`; it is NOT applied by default so a
// brand-new account can still write its own profile.
//
// Test these in the Firebase console's Rules Playground BEFORE shipping.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // comments: shared — any signed-in user reads, only the owner writes.
    match /comments/{docId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // follows: shared — any signed-in user reads, only the owner writes.
    match /follows/{docId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // posts: shared — any signed-in user reads, only the owner writes.
    match /posts/{docId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // users: documents named by uid — path-scoped to the owner.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      match /{document=**} { allow read, write: if isOwner(userId); }
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}"
`;

exports[`BackendBlueprint > writes a GoogleService-Info.plist once every credential is present 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>AIzaTESTKEY</string>
	<key>GCM_SENDER_ID</key>
	<string>1234567890</string>
	<key>GOOGLE_APP_ID</key>
	<string>1:1234567890:ios:abcdef</string>
	<key>PROJECT_ID</key>
	<string>demo-app</string>
	<key>STORAGE_BUCKET</key>
	<string>demo-app.appspot.com</string>
	<key>BUNDLE_ID</key>
	<string>com.agentic.demo</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
</dict>
</plist>
"
`;
